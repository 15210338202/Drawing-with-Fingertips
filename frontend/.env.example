# 复制本文件为 frontend/.env 再填真值；.env 已在 .gitignore 里，不会被提交

# 对话与意图解析（DeepSeek V4.1-Flash，OpenAI 兼容接口）
DEEPSEEK_API_KEY=

# 图像生成（Cloudflare Workers AI，见 frontend/server/api/generate.post.ts）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 可选：换图生图模型，不填默认 @cf/black-forest-labs/flux-2-klein-4b
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
